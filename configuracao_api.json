{
  "provedor": "OpenRouter",
  "base_url": "https://openrouter.ai/api/v1",
  "variavel_da_chave": "OPENROUTER_API_KEY",
  "interface": "compatível com o SDK da OpenAI (chat.completions)",
  "modelo": "deepseek/deepseek-v4-flash",
  "temperature": 0.0,
  "max_tokens": 1500,
  "response_format": {"type": "json_object"},
  "tentativas_por_anuncio": 3,
  "chamadas_simultaneas": 8,
  "preco_usd_por_milhao_de_tokens": {"entrada": 0.08, "saida": 0.16}
}
